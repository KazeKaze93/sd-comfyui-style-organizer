#!/usr/bin/env bash
# Local quality gate (replaces GitHub Actions CI). Abort push on failure.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "pre-push: EOL guard"
if git ls-files --eol | grep -E 'i/crlf|w/crlf' ; then
  echo "pre-push: CRLF found in index or text working files (see above). Fix with git add --renormalize + rewrite from index." >&2
  exit 1
fi
if git grep -I -l $'\r' -- web/ui ; then
  echo "pre-push: CR bytes in committed web/ui (see above). Rebuild from LF sources." >&2
  exit 1
fi

# Cross-repo SHA256 gate (same idea as csv-script safe_persistence parity):
# when the WebUI sibling golden is present, bytes must match or push fails.
echo "pre-push: sg_wildcard_golden.json SHA256 vs WebUI sibling"
GOLDEN="$ROOT/tests/fixtures/sg_wildcard_golden.json"
SIBLING_NAME="sd-webui-style-organizer"
SIBLING_GOLDEN="/d/SD/Packages/reforge/extensions/${SIBLING_NAME}/tests/fixtures/sg_wildcard_golden.json"
if [[ ! -f "$GOLDEN" ]]; then
  echo "pre-push: missing $GOLDEN" >&2
  exit 1
fi
_sha256() {
  python -c "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())" "$1"
}
if [[ -f "$SIBLING_GOLDEN" ]]; then
  LOCAL_HASH="$(_sha256 "$GOLDEN")"
  SIBLING_HASH="$(_sha256 "$SIBLING_GOLDEN")"
  if [[ "$LOCAL_HASH" != "$SIBLING_HASH" ]]; then
    echo "pre-push: sg_wildcard_golden.json SHA256 drift vs ${SIBLING_NAME}" >&2
    echo "  local:   $LOCAL_HASH" >&2
    echo "  sibling: $SIBLING_HASH ($SIBLING_GOLDEN)" >&2
    exit 1
  fi
  echo "pre-push: sg_wildcard_golden.json matches ${SIBLING_NAME}"
else
  echo "pre-push: sibling sg_wildcard_golden.json absent at ${SIBLING_GOLDEN}; skipping cross-repo hash check"
fi

echo "pre-push: stylegrid/deck.py SHA256 vs WebUI sibling"
DECK="$ROOT/stylegrid/deck.py"
SIBLING_DECK="/d/SD/Packages/reforge/extensions/${SIBLING_NAME}/stylegrid/deck.py"
if [[ ! -f "$DECK" ]]; then
  echo "pre-push: missing $DECK" >&2
  exit 1
fi
if [[ -f "$SIBLING_DECK" ]]; then
  LOCAL_DECK_HASH="$(_sha256 "$DECK")"
  SIBLING_DECK_HASH="$(_sha256 "$SIBLING_DECK")"
  if [[ "$LOCAL_DECK_HASH" != "$SIBLING_DECK_HASH" ]]; then
    echo "pre-push: stylegrid/deck.py SHA256 drift vs ${SIBLING_NAME}" >&2
    echo "  local:   $LOCAL_DECK_HASH" >&2
    echo "  sibling: $SIBLING_DECK_HASH ($SIBLING_DECK)" >&2
    exit 1
  fi
  echo "pre-push: stylegrid/deck.py matches ${SIBLING_NAME}"
else
  echo "pre-push: sibling deck.py absent at ${SIBLING_DECK}; skipping cross-repo hash check"
fi

echo "pre-push: pytest (min count enforced)"
python scripts/run_pytest_min.py

echo "pre-push: UI typecheck + lint + vitest"
(
  cd ui
  npx tsc --noEmit -p tsconfig.app.json
  npx tsc --noEmit -p tsconfig.node.json
  npx tsc --noEmit -p tsconfig.test.json
  npm run lint
  npm test
)

echo "pre-push: rebuild UI and require web/ui match"
(
  cd ui
  npm run build
)
echo "pre-push: built CSS must not contain template residue (dynamic Tailwind class)"
if grep -l -F '\$\{' web/ui/assets/*.css; then
  echo "pre-push: built CSS contains a mangled dynamic class. Use literal class strings in Tailwind utilities." >&2
  exit 1
fi

git diff --exit-code -- web/ui

echo "pre-push: ok"
